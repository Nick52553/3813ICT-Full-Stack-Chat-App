{
  "name": "chat-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "start-server-and-test e2e:backend http://localhost:3000 e2e:frontend http://localhost:4200 cy:run",
    "e2e:backend": "npm --prefix ../../backend run start:e2e",
    "e2e:frontend": "ng serve --port 4200",
    "cy:run": "node cypress/run.js",
    "cy:open": "node cypress/run.js open",
    "docs:screenshots": "start-server-and-test e2e:backend http://localhost:3000 e2e:frontend http://localhost:4200 cy:docs",
    "cy:docs": "node cypress/run.js docs"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "cypress": "^16.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
